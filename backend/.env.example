DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/orqbit

# Time for initial lease in seconds
LEASE_SECONDS=120

# Time given after a heartbeat in seconds
LEASE_EXTENSION_SECONDS=60

# Total attempts per new job (1-5), including the first; 1 disables retries.
MAX_ATTEMPTS=1

SECRET_KEY=replace_with_secret_key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

RECOVERY_INTERVAL_SECONDS=5
RECOVERY_BATCH_SIZE=1000
MAX_UNKNOWN_DATABASE_ERRORS=3
