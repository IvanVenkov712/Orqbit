# Local development only. Copy to .env.compose and choose your credentials.
# Keep these values consistent with DATABASE_URL below.
POSTGRES_DB=orqbit
POSTGRES_USER=orqbit_dev
POSTGRES_PASSWORD=change_this_local_password

# Containers reach PostgreSQL by the Compose service name, db, not localhost.
# URL-encode reserved characters if you change the password in this URL.
DATABASE_URL=postgresql+psycopg://orqbit_dev:change_this_local_password@db:5432/orqbit

LEASE_SECONDS=120
LEASE_EXTENSION_SECONDS=60
API_PORT=8000

SECRET_KEY=replace_with_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
